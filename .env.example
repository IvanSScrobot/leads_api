# ============================================================================
# PostgreSQL Configuration
# ============================================================================
# Required for both survey submission and API key authentication
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ardent_survey
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================================
# Phone Validation Configuration
# ============================================================================
# Allow international numbers (true/false)
INTERNATIONAL_NUMBERS_ALLOWED=false

# ============================================================================
# Application Configuration
# ============================================================================
PORT=8000

# ============================================================================
# Consent Validation Configuration
# ============================================================================
# Set to 'true' to require both privacyConsent and consentToUseAI to be True
# Set to 'false' to accept submissions even if consents are False
# Default: true (strict consent checking enabled)
CHECK_CONSENTS=true

# ============================================================================
# Test Mode Configuration
# ============================================================================
# Set to 'true' to enable test mode (uses mock API keys, no database required)
# Useful for running tests without PostgreSQL
TEST_MODE=false